---
layout: base
title: All Items
---
<h1>All items <span class="count">({{ items | length }})</span></h1>
<p class="lead">Everything in the rolling 14-day window, newest first.</p>
<ul class="items">
  {% for it in items %}
    <li class="item">
      <a href="{{ it.link }}">{{ it.title }}</a>
      <div class="meta">{{ it.source_name }} · {{ it.category }} · {{ it.published | fmtDate }}{% for t in it.tags %} <a class="tag" href="/tags/{{ t | slug }}/">{{ t }}</a>{% endfor %}</div>
    </li>
  {% endfor %}
</ul>
